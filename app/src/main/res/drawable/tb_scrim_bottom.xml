<?xml version="1.0" encoding="utf-8"?>
<!--
  Bottom fade for the gray screens. The artwork is a bright, detailed scene all
  the way down, so the CTA row needs its own contrast floor — without it the
  amber buttons wash out against the lit shopfronts.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#C7090401"
        android:centerColor="#66090401"
        android:endColor="#00090401"
        android:type="linear" />
</shape>
