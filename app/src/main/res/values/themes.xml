<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TowerBreak" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ribbon_deep</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.TowerBreak.Splash" parent="Theme.TowerBreak">
        <item name="android:windowBackground">@color/ribbon_deep</item>
    </style>

    <!-- Gray-part AppCompat themes (rebrand may rename BastionImmersive / Stream tokens). -->
    <style name="Theme.App" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>

    <style name="Theme.App.BastionImmersive" parent="Theme.App">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.App.Stream" parent="Theme.App">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
